.env
.env.*
!.env.example

# Databricks local CLI config (can contain tokens)
.databricks/
*.databricks.cfg
databricks.cfg

# Token / key / credential files
*.pem
*.key
*.keystore
id_rsa*
*credentials*.json
*credential*.json
secrets.json
secrets.yaml
secrets.yml
secrets.toml
*.token
*_token.txt
__pycache__/
*.pyc
.venv/
.spark-warehouse/
.pytest_cache/

# Generic sensitive file names
*.secret

# === Databricks / Spark artifacts ===
# Local spark-warehouse and Derby metastore from local Spark runs
spark-warehouse/
derby.log
metastore_db/

# MLflow local tracking artifacts
mlruns/

